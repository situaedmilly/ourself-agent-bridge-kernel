# ÆTHERNET Agent Bridge — Environment Variables
# Copy to .env and fill in your API keys.
# NEVER commit .env — it is gitignored.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Authentication token for state-changing routes (Pass 18).
# Required — the bridge fails closed and will not start without it.
# Do NOT put a real value here. Generate one into your .env with:
#     npm run setup
# Callers send it in the  x-ourself-token  request header.
BRIDGE_TOKEN=

# Server port (default: 3001)
PORT=3001

# Model overrides (optional — defaults shown)
# CLAUDE_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
