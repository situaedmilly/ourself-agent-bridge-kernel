# OURTUNNELSELF dedicated gateway environment
# Store as /etc/ourtunnelself/ourtunnelself.env; chmod 0600.
OURTUNNELSELF_BIND=127.0.0.1
OURTUNNELSELF_PORT=8787
OURTUNNELSELF_DATA_DIR=/var/lib/ourtunnelself
OURTUNNELSELF_DEVICE_REGISTRY=/etc/ourtunnelself/devices.json
OURTUNNELSELF_BROKER_PRIVATE_KEY=/etc/ourtunnelself/broker-private.pem
OURTUNNELSELF_SEAT_PUBLIC_KEY=/etc/ourtunnelself/seat-public.pem
OURTUNNELSELF_PORTAL_PUBLIC_KEY=/etc/ourtunnelself/portal-public.pem
OURTUNNELSELF_SEAT_ISSUER=REPLACE_WITH_OSOS_SEAT_ISSUER
OURTUNNELSELF_SEAT_AUDIENCE=ourtunnelself
OURTUNNELSELF_PORTAL_ISSUER=REPLACE_WITH_OSOS_PORTAL_ISSUER
OURTUNNELSELF_PORTAL_AUDIENCE=ourtunnelself
