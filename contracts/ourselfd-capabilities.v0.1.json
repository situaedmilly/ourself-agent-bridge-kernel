{
  "version": "0.1",
  "authority": "OURSELFd",
  "transition_endpoint": "POST /v1/transitions/request",
  "capabilities": {
    "repo.read": {
      "mutability": "read",
      "exposed": false,
      "receipt_required": true,
      "implementation_status": "DECLARED_NOT_IMPLEMENTED"
    },
    "repo.status": {
      "mutability": "read",
      "exposed": true,
      "receipt_required": true,
      "operation": "git_status",
      "implemented": true,
      "implementation_status": "IMPLEMENTED"
    },
    "repo.diff": {
      "mutability": "read",
      "exposed": false,
      "receipt_required": true,
      "implementation_status": "DECLARED_NOT_IMPLEMENTED"
    }
  },
  "explicitly_absent": [
    "shell.execute",
    "process.start",
    "repo.write",
    "file.write",
    "arbitrary_filesystem_access"
  ],
  "state_machine": [
    "REQUESTED",
    "RESOLVED",
    "AUTHENTICATED",
    "AUTHORIZED",
    "PRECONDITIONS_SATISFIED",
    "ADMITTED",
    "ACTUATED",
    "OBSERVED",
    "RECEIPTED"
  ],
  "non_collapse": [
    "INTENT != AUTHORITY",
    "AUTHORITY != ADMISSION",
    "ADMISSION != ACTUATION",
    "ACTUATION != OBSERVATION",
    "OBSERVATION != RECEIPT",
    "RECEIPT != MEMORY"
  ]
}
