{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ourself.invalid/contracts/ourself-tunnel-session.v0.1.schema.json",
  "title": "OURTUNNELSELF Session Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tunnel_id",
    "tunnel_identity",
    "session_id",
    "device_identity_ref",
    "endpoint_identity",
    "caller_identity_ref",
    "seat_identity_ref",
    "source_jurisdiction",
    "target_jurisdiction",
    "portal_decision_ref",
    "authority_grant_ref",
    "purpose",
    "admitted_capabilities",
    "transport_adapter",
    "transport_session_id",
    "issued_at",
    "expires_at",
    "revocation_epoch",
    "sequence_start",
    "nonce",
    "device_key_ref",
    "signature"
  ],
  "properties": {
    "contract_version": { "const": "0.1" },
    "tunnel_id": { "type": "string", "minLength": 1 },
    "tunnel_identity": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "device_identity_ref": { "type": "string", "minLength": 1 },
    "endpoint_identity": { "type": "string", "minLength": 1 },
    "caller_identity_ref": { "type": "string", "minLength": 1 },
    "seat_identity_ref": { "type": "string", "minLength": 1 },
    "source_jurisdiction": { "type": "string", "minLength": 1 },
    "target_jurisdiction": { "type": "string", "minLength": 1 },
    "portal_decision_ref": { "type": "string", "minLength": 1 },
    "authority_grant_ref": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "admitted_capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "transport_adapter": { "type": "string", "enum": ["selfhosted-wss", "wireguard", "ssh-reverse", "cloudflare-optional"] },
    "transport_session_id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "sequence_start": { "type": "integer", "minimum": 0 },
    "nonce": { "type": "string", "minLength": 16 },
    "device_key_ref": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
