{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ourself.invalid/schemas/independent-certifier-binding.v0.1.schema.json",
  "title": "OURSELF Independent Certifier Trust-Domain Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["certifierId", "trustDomainId", "substrateType", "status"],
  "properties": {
    "certifierId": { "type": "string", "minLength": 1 },
    "trustDomainId": { "type": "string", "minLength": 1 },
    "substrateType": {
      "enum": ["PHYSICAL_DEVICE", "HARDWARE_BACKED_SIGNING_SERVICE"]
    },
    "substrateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableIdentity", "identityType", "evidenceRef"],
      "properties": {
        "immutableIdentity": { "type": "string", "minLength": 1 },
        "identityType": {
          "enum": ["HARDWARE_ATTESTED_ID", "PROVIDER_RESOURCE_ID", "SERVICE_TENANT_ID"]
        },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "identityEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "jurisdictionEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "custodyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCustodianRole",
        "operationalSignerRole",
        "privateKeyNonExportableOrOffline",
        "recoveryOwner"
      ],
      "properties": {
        "rootCustodianRole": { "type": "string", "minLength": 1 },
        "operationalSignerRole": { "type": "string", "minLength": 1 },
        "privateKeyNonExportableOrOffline": { "type": "boolean", "const": true },
        "recoveryOwner": { "type": "string", "minLength": 1 }
      }
    },
    "auditRecontact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditEvidenceRef", "independentRecontactMethod"],
      "properties": {
        "auditEvidenceRef": { "type": "string", "minLength": 1 },
        "independentRecontactMethod": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "enum": ["DECLARED", "DISCOVERED", "IDENTITY_VERIFIED", "BOUND"]
    },
    "privateKeyMaterial": { "const": null },
    "endpointHostIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "not": {
        "contains": {
          "enum": ["HW-OURSELFMAC-001", "HW-OURSELFPIMAC-001"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["DISCOVERED", "IDENTITY_VERIFIED", "BOUND"] } },
        "required": ["status"]
      },
      "then": { "required": ["identityEvidenceRefs"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["IDENTITY_VERIFIED", "BOUND"] } },
        "required": ["status"]
      },
      "then": { "required": ["substrateIdentity"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "BOUND" } },
        "required": ["status"]
      },
      "then": {
        "required": ["jurisdictionEvidenceRefs", "custodyBoundary", "auditRecontact"]
      }
    }
  ]
}
