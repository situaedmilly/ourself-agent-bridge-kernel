{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ourself.invalid/schemas/independent-certifier-binding.v0.1.schema.json",
  "title": "OURSELF Independent Certifier Trust-Domain Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certifierId",
    "trustDomainId",
    "substrateType",
    "identityEvidenceRefs",
    "jurisdictionEvidenceRefs",
    "custodyBoundary",
    "auditRecontact",
    "status"
  ],
  "properties": {
    "certifierId": {
      "type": "string",
      "minLength": 1
    },
    "trustDomainId": {
      "type": "string",
      "minLength": 1
    },
    "substrateType": {
      "enum": [
        "PHYSICAL_DEVICE",
        "HARDWARE_BACKED_SIGNING_SERVICE"
      ]
    },
    "substrateIdentity": {
      "type": [
        "object",
        "null"
      ]
    },
    "identityEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jurisdictionEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "custodyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCustodianRole",
        "operationalSignerRole",
        "privateKeyNonExportableOrOffline",
        "recoveryOwner"
      ],
      "properties": {
        "rootCustodianRole": {
          "type": "string",
          "minLength": 1
        },
        "operationalSignerRole": {
          "type": "string",
          "minLength": 1
        },
        "privateKeyNonExportableOrOffline": {
          "type": "boolean",
          "const": true
        },
        "recoveryOwner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auditRecontact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditEvidenceRef",
        "independentRecontactMethod"
      ],
      "properties": {
        "auditEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "independentRecontactMethod": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "DECLARED",
        "DISCOVERED",
        "IDENTITY_VERIFIED",
        "BOUND"
      ]
    },
    "rootKeyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "publicKeyFingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "privateKeyMaterial": {
      "const": null
    },
    "endpointHostIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "not": {
        "contains": {
          "enum": [
            "HW-OURSELFMAC-001",
            "HW-OURSELFPIMAC-001"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "BOUND"
          }
        }
      },
      "then": {
        "required": [
          "substrateIdentity",
          "rootKeyId",
          "publicKeyFingerprint"
        ]
      }
    }
  ]
}
